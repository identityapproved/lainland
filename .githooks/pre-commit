#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

python3 - <<'PY' "$root" "$HOME"
import os, sys, subprocess

root = sys.argv[1]
home = sys.argv[2].encode()
replacement = b"$HOME"

try:
    result = subprocess.run(
        ["git", "-C", root, "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
except Exception:
    sys.exit(0)

files = [os.path.join(root, f) for f in result.stdout.decode().splitlines()]

for path in files:
    try:
        data = open(path, "rb").read()
    except OSError:
        continue
    if home not in data:
        continue
    sanitized = data.replace(home, replacement)
    open(path, "wb").write(sanitized)
    subprocess.run(["git", "add", path], check=True)
    print(f"sanitized: {os.path.relpath(path, root)}")
PY
