# The Lain palette lives in the private lainland-private repo and is symlinked
# in as lain-colors.md. It must never enter this repo's history.
lain-colors.md

# Agent scratch
AGENTS.md
agents/
DONT_FORGET.md
yay

# tmux plugins are no longer used; this guards a stale ~/.config/tmux/plugins.
home/dot_config/tmux/plugins
home/dot_config/tmux/tmux_old.conf

# Not themed yet (keep local until the Lain pass reaches them)
home/dot_config/alacritty/
home/dot_config/ghostty/
home/dot_config/cmus/
home/dot_config/translate-shell/
home/dot_config/wpaperd/

# Vesktop: keep only the curated theme, ignore runtime/session/cache noise.
# Under chezmoi the target is a real directory with individual files linked in,
# so everything below simply never becomes a source file.
#
# settings.json is deliberately NOT managed: it is live Vencord state that the
# app rewrites constantly, and the copy this repo used to carry was a stale
# snapshot that would have reverted every plugin toggle on apply. Enabling the
# Lain theme is a one-time click in Vesktop's Themes pane.
home/dot_config/vesktop/*
!home/dot_config/vesktop/README.md
!home/dot_config/vesktop/themes/
!home/dot_config/vesktop/themes/lain.theme.css

# mimeapps.list is per-machine desktop state (the default browser is recorded
# there with a generated userapp-*.desktop id), not rice. Not managed.
home/dot_config/mimeapps.list

# Liferea: same story. feedlist.opml and the item DB stay out of the repo.
home/dot_config/liferea/feedlist.opml*
home/dot_config/liferea/user.js

# Walker regenerates themes/default.* on every start -- it stamps them
# "AUTO GENERATED. DO NOT EDIT." and means it, replacing whatever is at that
# path, chezmoi's symlink included. Only the hand-written lain.* is ours.
home/dot_config/walker/themes/default.css
home/dot_config/walker/themes/default.toml
home/dot_config/walker/themes/default_window.toml

# Clipse: keep config/theme, ignore runtime state
home/dot_config/clipse/clipboard_history.json
home/dot_config/clipse/clipse.log
home/dot_config/clipse/tmp_files/

# Spotify/Spicetify: keep theme + config, ignore runtime/user state
home/dot_config/spotify/prefs
home/dot_config/spotify/Users/

# Python bytecode from the waybar/liferea/mango helper scripts
__pycache__/
*.pyc
