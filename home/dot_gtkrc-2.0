# GTK2 — Lain. Written by hand, not by nwg-look; nwg-look will overwrite it if
# you press Apply there, and this file is a chezmoi symlink into the repo, so
# that overwrite lands in the working tree where you can see and revert it.
# Machine-local tweaks belong in ~/.gtkrc-2.0.mine, which GTK2 also reads.

gtk-theme-name="lain"
gtk-icon-theme-name="lainicons"
gtk-cursor-theme-name="lainicons"
gtk-cursor-theme-size=24
gtk-font-name="Iosevka Nerd Font 11"
gtk-toolbar-style=GTK_TOOLBAR_BOTH_HORIZ
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=1
gtk-menu-images=1
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintmedium"
gtk-xft-rgba="rgb"
