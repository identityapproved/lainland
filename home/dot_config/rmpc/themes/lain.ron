// rmpc — Lain. Palette: lain-colors.md (private repo).
//
// Derived from the upstream tokyonight-night theme, recolored through the
// palette's Semantic Role Map. Roles that Tokyo Night spreads over six hues
// collapse onto two ramps here: rose (Fore) carries text and chrome, ochre
// (High) carries selection and emphasis. Error text uses `accent` rather than
// `error-bg` #930006 -- that value is a fill, and fails contrast as text.
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    multiple_tag_resolution_strategy: All,
    browser_column_widths: [20, 38, 42],
    background_color: "#000000",
    modal_backdrop: true,
    text_color: "#CE7688",
    header_background_color: "#000000",
    modal_background_color: "#000000",
    preview_label_style: (fg: "#A49978"),
    preview_metadata_group_style: (fg: "#C1B48E"),
    song_table_album_separator: None,
    tab_bar: (
        active_style: (fg: "#000000", bg: "#C1B48E", modifiers: "Bold"),
        inactive_style: (fg: "#804654", bg: "#000000"),
    ),
    highlighted_item_style: (fg: "#FFB1C3", modifiers: "Bold"),
    current_item_style: (fg: "#000000", bg: "#C1B48E", modifiers: "Bold"),
    borders_style: (fg: "#C1B48E", modifiers: "Bold"),
    highlight_border_style: (fg: "#C1B48E"),
    symbols: (song: "󰝚 ", dir: "󱍙 ", playlist: "󰲸 ", marker: "* ", ellipsis: "...",
        song_style: (fg: "#C1B48E"), song_highlighted_style: None, song_current_style: (fg: "#000000"),
        dir_style: (fg: "#C1B48E"), dir_highlighted_style: None, dir_current_style: (fg: "#000000"),
        playlist_style: (fg: "#C1B48E"), playlist_highlighted_style: None, playlist_current_style: (fg: "#000000"),
        marker_style: (fg: "#FFDCB9"), marker_highlighted_style: (fg: "#FFDCB9"), marker_current_style: (fg: "#000000", bg: "#FFDCB9" ),
    ),
    progress_bar: (
        symbols: ["▓", "█", "░", "█", "▓" ], // 
        track_style: (fg: "#3A3A3A", bg: "#000000"),
        elapsed_style: (fg: "#C1B48E", bg: "#000000"),
        thumb_style: (fg: "#C1B48E", bg: "#3A3A3A"),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: ["┋", "█", "󰄿", "󰄼"],
        track_style: (fg: "#C1B48E"),
        ends_style: (fg: "#C1B48E"),
        thumb_style: (fg: "#C1B48E"),
    ),
    song_table_format: [
        (prop: (kind: Transform(Replace(content: (kind: Sticker("rating")), replacements: [
            (match:  "0", replace: (kind: Group([(kind: Text("󰎡"),style: (fg: "#C1B48E"))]))),
            (match:  "1", replace: (kind: Group([(kind: Text("󰎤"),style: (fg: "#C1B48E"))]))),
            (match:  "2", replace: (kind: Group([(kind: Text("󰎧"),style: (fg: "#C1B48E"))]))),
            (match:  "3", replace: (kind: Group([(kind: Text("󰎪"),style: (fg: "#C1B48E"))]))),
            (match:  "4", replace: (kind: Group([(kind: Text("󰎭"),style: (fg: "#C1B48E"))]))),
            (match:  "5", replace: (kind: Group([(kind: Text("󰎱"),style: (fg: "#C1B48E"))]))),
            (match:  "6", replace: (kind: Group([(kind: Text("󰎳"),style: (fg: "#C1B48E"))]))),
            (match:  "7", replace: (kind: Group([(kind: Text("󰎶"),style: (fg: "#C1B48E"))]))),
            (match:  "8", replace: (kind: Group([(kind: Text("󰎹"),style: (fg: "#C1B48E"))]))),
            (match:  "9", replace: (kind: Group([(kind: Text("󰎼"),style: (fg: "#C1B48E"))]))),
            (match: "10", replace: (kind: Group([(kind: Text("󰽽"),style: (fg: "#C1B48E"))]))),
        ])), default: (kind: Text(""), style: (fg: "#804654"))),
        width: "3",
        label: "Rating",
        alignment: Center,
            label_prop: (kind: Group([
                (kind: Text("󰩳"), style: (fg: "#C1B48E")),
            ]))
        ),
        (prop: (kind: Sticker("playCount"),style: (fg: "#C1B48E"),
            default: (kind: Text(""), style: (fg: "#804654"))),
            width: "3",
            alignment: Left,
            label: "Playcount",
            label_prop: (kind: Group([
                (kind: Text("󰆙"), style: (fg: "#C1B48E")),
            ]))
        ),
        (prop:(kind: Text("│"), style: (fg: "#C1B48E")),
            width: "1",
            alignment: Center,
            label: "",
            label_prop: (kind: Group([
                (kind: Text("│"), style: (fg: "#C1B48E")),
            ]))
        ),
        (prop: (kind: Property(Artist), style: (fg: "#C1B48E"),
            default: (kind: Text("Unknown Artist"), style: (fg: "#804654"))),
            width: "23%",
            label_prop: (kind: Group([
                (kind: Text("Artist "), style: (fg: "#CE7688")),
                (kind: Text(""), style: (fg: "#C1B48E"))
            ]))
        ),
        (prop: (kind: Property(Title), style: (fg: "#BA6A7B"),
            default: (kind: Property(Filename), style: (fg: "#CE7688"),
                default: (kind: Text("Unknown Title"), style: (fg: "#CE7688")))),
            width: "36%",
            label_prop: (kind: Group([
                (kind: Text("Title "), style: (fg: "#CE7688")),
                (kind: Text(""), style: (fg: "#C1B48E"))
            ]))
        ),
        (prop: (kind: Property(Album), style: (fg: "#C1B48E"),
            default: (kind: Text("Unknown Album"), style: (fg: "#804654"))),
            width: "33%",
            label_prop: (kind: Group([
                (kind: Text("Album "), style: (fg: "#CE7688")),
                (kind: Text("󰀥"), style: (fg: "#C1B48E"))
            ]))
        ),
        (prop: (kind: Property(Duration), style: (fg: "#BA6A7B"),
            default: (kind: Text("-"))),
            width: "8%",
            alignment: Right,
            label_prop: (kind: Group([
                (kind: Text("Length "), style: (fg: "#CE7688")),
                (kind: Text(" "), style: (fg: "#C1B48E"))
            ]))
        ),
    ],
    layout: Split(direction: Vertical, panes: [
            (size: "7", borders: "NONE", pane: Component("header")),
            (size: "100%", borders: "NONE", pane: Pane(TabContent)),
            (size: "3", borders: "NONE", pane: Component("progress_bar")),
    ]),
    browser_song_format: [
        (kind: Group([
            (kind: Property(Track)),
            (kind: Text(" ")),
        ])),
        (kind: Group([
            (kind: Property(Artist)),
            (kind: Text(" - ")),
            (kind: Property(Title)),
        ]), default: (kind: Property(Filename)))
    ],
    level_styles: (
        info:  (fg: "#FFB1C3", bg: "#000000"),
        warn:  (fg: "#FFDCB9", bg: "#000000"),
        error: (fg: "#FFB1C3", bg: "#000000"),
        debug: (fg: "#FFDCB9", bg: "#000000"),
        trace: (fg: "#A49978", bg: "#000000"),
    ),
    components: {
        "header_tab_bar": Split(direction: Horizontal, panes: [
            (size: "11%", borders: "NONE", pane: Component("tab_bar_left")),
            (size: "78%", borders: "NONE", pane: Pane(Tabs)),
            (size: "11%", borders: "NONE", pane: Component("tab_bar_right")),
        ]),
        "header_line_1": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_1")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_2")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_3")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_2": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_4")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_5")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_6")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_3": Split(direction: Horizontal, panes: [
            (size: "25%", pane: Component("header_element_7")),
            (size: "1", pane: Component("header_element_space")),
            (size: "50%", pane: Component("header_element_8")),
            (size: "1", pane: Component("header_element_space")),
            (size: "25%", pane: Component("header_element_9")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header": Split(direction: Vertical, panes: [
            (size: "2", borders: "TOP | RIGHT | LEFT", border_symbols: Plain,
                pane: Split(direction: Horizontal, panes: [
                    (size: "100%", borders: "NONE", pane: Component("header_tab_bar")),
                ])
            ),
            (size: "5", borders: "ALL", border_symbols: Library("collapsed_top"),
                border_title: [
                    (kind: Text("─"), style: (fg: "#C1B48E")),
                    (kind: Transform(Replace(content: (kind: Sticker("rating")), replacements: [
                        (match:  "0", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("     "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "1", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text(" "),         style: (fg: "#BA6A7B")), (kind: Text("    "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "2", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text(" "),         style: (fg: "#BA6A7B")), (kind: Text("    "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "3", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("  "),       style: (fg: "#BA6A7B")), (kind: Text("   "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "4", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("  "),       style: (fg: "#BA6A7B")), (kind: Text("   "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "5", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("   "),     style: (fg: "#BA6A7B")), (kind: Text("  "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "6", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("   "),     style: (fg: "#BA6A7B")), (kind: Text("  "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "7", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("    "),   style: (fg: "#BA6A7B")), (kind: Text(" "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "8", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("    "),   style: (fg: "#BA6A7B")), (kind: Text(" "), style: (fg: "#C1B48E")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match:  "9", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("     "), style: (fg: "#BA6A7B")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                        (match: "10", replace: (kind: Group([(kind: Text("["), style: (fg: "#C1B48E")), (kind: Text("     "), style: (fg: "#BA6A7B")), (kind: Text("]"), style: (fg: "#C1B48E"))]))),
                    ])), default: (kind: Text("─"),style: (fg: "#C1B48E"))),
                    (kind: Text("─"), style: (fg: "#C1B48E")),
                ],
                border_title_position: Bottom,
                border_title_alignment: Right,
                pane: Split(direction: Vertical, panes: [
                    (size: "100%", borders: "NONE", pane: Component("header_line_1")),
                    (size: "100%", borders: "NONE", pane: Component("header_line_2")),
                    (size: "100%", borders: "NONE", pane: Component("header_line_3")),
                ])
            ),
        ]),
        "progress_bar": Split(direction: Vertical, panes: [
                (size: "3", borders: "ALL", border_symbols: Plain ,
                    border_title: [
                        (kind: Property(Status(Elapsed)),style: (fg: "#CE7688")),
                        (kind: Property(Status(StateV2(playing_label: "─󱦟─", paused_label: "  ", stopped_label: "  "))),
                            style: (fg: "#C1B48E", modifiers: "Bold")),
                        (kind: Property(Status(Duration)),style: (fg: "#CE7688")),
                    ],
                    border_title_position: Top,
                    border_title_alignment: Center,
                    pane: Split(direction: Vertical, panes: [
                        (size: "100%", borders: "NONE",pane: Pane(ProgressBar)),
                    ])
                ),
        ]),
        "tab_bar_left": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" "), style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(StateV2(playing_label: "", paused_label: "", stopped_label: ""))),
                    style: (fg: "#CE7688")),
                (kind: Text("  "), style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Song(FileExtension)), style: (fg: "#804654")),
                (kind: Text(" ")),
                (kind: Property(Widget(ScanStatus)), style: (fg: "#CE7688", modifiers: "Bold")),
                (kind: Text(" ")),
                (kind: Property(Status(InputBuffer())), style: (fg: "#804654")),
            ], align: Left))),
        ]),
        "tab_bar_right": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content: (kind: Property(Status(Partition)), style: (fg: "#804654")), replacements: [
                    (match:  "default", replace: (kind: Group([(kind: Text(""))]))),
                ]))),
                (kind: Text(" ")),
                (kind: Property(Song(Channels())), style: (fg: "#804654"),
                    default: (kind: Text("0"), style: (fg: "#804654"))),
                (kind: Text(" 󱡫 "),style: (fg: "#804654")),
                (kind: Text(" 󱡬"), style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(Volume)), style: (fg: "#CE7688")),
                (kind: Text("% "), style: (fg: "#C1B48E", modifiers: "Bold"))
            ], align: Right))),
        ]),
        "header_element_1": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(Elapsed)),style: (fg: "#CE7688")),
                (kind: Text(" / "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(Duration)),style: (fg: "#CE7688")),
                (kind: Text(" 󱦟"),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Text(" ]"),style: (fg: "#C1B48E", modifiers: "Bold")),
            ], align: Left))),
        ]),
        "header_element_2": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Property(Song(Title)), style: (fg: "#CE7688",modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "#CE7688",modifiers: "Bold"),
                    default: (kind: Text("Unknown Title"), style: (fg: "#CE7688",modifiers: "Bold"))))
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_3": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(RepeatV2(on_label: "", off_label: "",
                    on_style: (fg: "#CE7688", modifiers: "Bold"),
                    off_style: (fg: "#804654", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(RandomV2(on_label: "", off_label: "",
                    on_style: (fg: "#CE7688", modifiers: "Bold"),
                    off_style: (fg: "#804654", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(ConsumeV2(on_label: "󰮯", off_label: "󰮯", oneshot_label: "󰮯󰇊",
                    on_style: (fg: "#CE7688", modifiers: "Bold"),
                    off_style: (fg: "#804654", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(SingleV2(on_label: "󰎤", off_label: "󰎦", oneshot_label: "󰇊", off_oneshot_label: "󱅊",
                    on_style: (fg: "#CE7688", modifiers: "Bold"),
                    off_style: (fg: "#804654", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(Crossfade)),style: (fg: "#804654"),
                    default: (kind: Text("󰴽"), style: (fg: "#804654"))
                ),
                (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match:  "Normal", replace: (kind: Group([(kind: Text("N"),style: (fg: "#804654", modifiers: "Bold"))]))),
                    (match:  "Insert", replace: (kind: Group([(kind: Text("I"),style: (fg: "#CE7688", modifiers: "Bold"))]))),
                ]))),
            ], align: Right))),
        ]),
        "header_element_4": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Song(Bits())),default: (kind: Text(" "), style: (fg: "#CE7688")), style: (fg: "#CE7688")),
                (kind: Text(" bit"),style: (fg: "#C1B48E")),
                (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(Bitrate)),default: (kind: Text(" "), style: (fg: "#CE7688")),style: (fg: "#CE7688")),
                (kind: Text(" kbps"),style: (fg: "#C1B48E")),
                (kind: Text(" ]"),style: (fg: "#C1B48E", modifiers: "Bold"))
            ], align: Left))),
        ]),
        "header_element_5": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Artist)), style: (fg: "#BA6A7B"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#BA6A7B"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Artist"), style: (fg: "#BA6A7B"))])))]
                ))),
                (kind: Text(" - "), style: (fg: "#CE7688")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Album)),style: (fg: "#C1B48E" ),
                        default: (kind: Text("Unknown Album"), style: (fg: "#C1B48E"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Album"), style: (fg: "#C1B48E"))])))]
                ))),
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_6": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeRemaining(separator: " "))),style: (fg: "#CE7688")),
                (kind: Text(" / "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeTotal(separator: " "))),style: (fg: "#CE7688")),
                (kind: Text(" 󱎫"),style: (fg: "#C1B48E", modifiers: "Bold")),
            ], align: Right))),
        ]),
        "header_element_7": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
            (kind: Text("[ "),style: (fg: "#C1B48E", modifiers: "Bold")),
            (kind: Property(Song(SampleRate())),default: (kind: Text(" "), style: (fg: "#CE7688")), style: (fg: "#CE7688")),
            (kind: Text(" Hz"),style: (fg: "#C1B48E")),
            (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
            (kind: Property(Song(Position)), style: (fg: "#CE7688"),
                default: (kind: Text("0"), style: (fg: "#CE7688"))),
            (kind: Text(" / "),style: (fg: "#C1B48E", modifiers: "Bold")),
            (kind: Property(Status(QueueLength())),style: (fg: "#CE7688")),
            (kind: Text(" 󰴍"),style: (fg: "#C1B48E", modifiers: "Bold")),
            (kind: Text(" ]"),style: (fg: "#C1B48E", modifiers: "Bold"))
            ], align: Left))),
        ]),
        "header_element_8": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("albumartist"))),style: (fg: "#804654"),
                        default: (kind: Text("Unknown Albumartist"), style: (fg: "#804654"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Albumartist"), style: (fg: "#804654"))])))]
                ))),
                (kind: Text(" - "), style: (fg: "#804654")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("composer"))),style: (fg: "#804654"),
                        default: (kind: Text("Unknown Composer"), style: (fg: "#804654"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Composer"), style: (fg: "#804654"))])))]
                ))),
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_9": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("date"))),style: (fg: "#CE7688"),
                        default: (kind: Text("Unknown Date"), style: (fg: "#804654"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Date"), style: (fg: "#804654"))])))]
                ))),
                (kind: Text(" | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Track)),style: (fg: "#CE7688"),
                        default: (kind: Text("0"), style: (fg: "#804654"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("0"), style: (fg: "#804654"))])))]
                ))),
                (kind: Text(" / "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Disc)),style: (fg: "#CE7688"),
                        default: (kind: Text("0"), style: (fg: "#804654"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("0"), style: (fg: "#804654"))])))]
                ))),
                (kind: Text(" 󰥠 | "),style: (fg: "#C1B48E", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("genre"))),style: (fg: "#CE7688"),
                        default: (kind: Text("Unknown Genre"), style: (fg: "#804654"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Genre"), style: (fg: "#804654"))])))]
                ))),
            ], align: Right))),
        ]),
        "header_element_right_end": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" ]"),style: (fg: "#C1B48E", modifiers: "Bold")),
            ], align: Right))),
        ]),
        "header_element_space": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" ")),
            ], align: Right))),
        ]),
    },
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 1, bar_spacing: 1,
        bg_color: "#000000",
        bar_color: Gradient({
            0:   "#5A5341",
            33:  "#C1B48E",
            67:  "#BA6A7B",
            100: "#968C6E",
        })
    ),
    lyrics:(
        timestamp: false,
        alignment: Center,
    ),
    border_symbol_sets: {
        "collapsed_top": (
            parent: Plain,
            top_left: "├",
            top_right: "┤",
        ),
    },
)
