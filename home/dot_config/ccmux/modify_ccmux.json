{{- /* chezmoi:modify-template */ -}}
{{- /*
   ccmux's TUI (picker, sidebar) on the Lain palette.

   ccmux has no theme files. Its one hook is a `theme` object inside
   ~/.config/ccmux/ccmux.json, a built-in base plus per-key overrides, and the
   rest of that file is ccmux's own state, written by `ccmux config set` and by
   the agentsdots bootstrap (notifications). So this is a modify template, not a
   managed file: chezmoi feeds it the current JSON and it hands back the same
   JSON with `theme` replaced and nothing else touched. The file is written out,
   never symlinked. `ccmux config set` merges at the top level, so the theme
   survives it; the picker and sidebar read it when they launch.

   Every key is overridden, so the base only shows through if ccmux adds one.

   colors: the slots keep catppuccin's names, but what matters is the state each
   one paints. Lain has two hue families, rose and khaki, so states are told apart
   by family and lightness, in the roles the OpenCode theme already gives them:

     peach    working, claude           #CE7688  foreprimary (OpenCode primary)
     red      waiting on you, errors    #FFB1C3  accentpeak  (OpenCode error)
     green    finished unseen, success  #FFDCB9  successfg   (OpenCode success)
     teal     waiting on plan approval  #B5A985  highsecondary
     overlay  idle, dim text            #7A7A7A  kitty color8
     yellow   dirty tree, checks run    #968C6E  kitty color2
     blue     focused border, opencode  #BA6A7B  foresecondary
     mauve    headings, merged PRs      #CE7688  foreprimary

   ansi: kitty's sixteen verbatim (kitty/themes/lain-theme.conf), so a pane
   previewed in the picker looks the way it does in the terminal.

   Check with `ccmux config themes`: "active, +overrides" and no warnings.
*/ -}}
{{- $theme := fromJson `{
  "base": "catppuccin-mocha",
  "colors": {
    "text": "#C1B48E",
    "subtext": "#A49978",
    "overlay": "#7A7A7A",
    "border": "#3A3A3A",
    "surface": "#1A1A1A",
    "base": "#000000",
    "rosewater": "#C1B48E",
    "peach": "#CE7688",
    "red": "#FFB1C3",
    "green": "#FFDCB9",
    "teal": "#B5A985",
    "yellow": "#968C6E",
    "blue": "#BA6A7B",
    "mauve": "#CE7688"
  },
  "ansi": {
    "black": "#000000",
    "red": "#CE7688",
    "green": "#968C6E",
    "yellow": "#FFDCB9",
    "blue": "#8A8A8A",
    "magenta": "#BA6A7B",
    "cyan": "#A49978",
    "white": "#BABABA",
    "brightBlack": "#7A7A7A",
    "brightRed": "#FFB1C3",
    "brightGreen": "#B5A985",
    "brightYellow": "#FFDCB9",
    "brightBlue": "#9A9A9A",
    "brightMagenta": "#CE7688",
    "brightCyan": "#B5A985",
    "brightWhite": "#FFFFFF"
  }
}` -}}
{{- $prefs := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $prefs = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $prefs = setValueAtPath "theme" $theme $prefs -}}
{{ toPrettyJson $prefs -}}
