# gammastep — night colour temperature shift.
#
# Shared by every host: mango starts it from an exec-once, sway from an exec.
# The binary talks wlr-gamma-control-unstable-v1, which both compositors
# implement, so no root/DRM access is needed.
#
# Config is only read from ~/.config/gammastep/config.ini; without the binary
# the file is inert, like the launcher configs.

[general]
# Daytime is left at the panel's native white point; only the night side warms.
temp-day=6500
temp-night=4000

# Fade between the two over ~monotonic steps instead of snapping.
fade=1

# 1.0 keeps brightness alone -- dimming is brightnessctl / swayosd's job.
brightness-day=1.0
brightness-night=1.0

# No per-channel gamma correction; the Lain palette is calibrated against the
# untouched ramp.
gamma=1.0

# Solar transitions from a fixed location, set as `lat`/`lon` at `chezmoi init`
# and kept only in ~/.config/chezmoi/chezmoi.toml. geoclue2 is avoided
# deliberately: it is a D-Bus service that reaches the network. With no location
# set, gammastep falls back to its own provider list.
{{- $lat := "" }}{{ if hasKey . "lat" }}{{ $lat = .lat }}{{ end }}
{{- $lon := "" }}{{ if hasKey . "lon" }}{{ $lon = .lon }}{{ end }}
{{- if and $lat $lon }}
location-provider=manual
{{- end }}

# wlroots gamma control. The redshift-inherited randr/vidmode methods are X11
# and would fail under XWayland-less sessions.
adjustment-method=wayland
{{- if and $lat $lon }}

[manual]
lat={{ $lat }}
lon={{ $lon }}
{{- end }}
