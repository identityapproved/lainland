### lainsway — Sway config for a Void Linux laptop (single output eDP-1)
#
# Palette: lain-colors.md. Font: IosevkaTerm Nerd Font Mono.
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Preferred terminal emulator. Resolved at chezmoi apply time by
# ~/.config/scripts/term, which picks the first installed of kitty/foot/alacritty
# and normalises the per-emulator flag spelling. Same indirection as
# hypr/configs/defaults.conf and mango/config.conf.
set $term ~/.config/scripts/term
# Application launcher (lain colors)
# Launcher is tofi; see .config/tofi/config. wmenu was retired with $mod+d.

xwayland enable

### Autostart
#
# The D-Bus session is started by start-sway *before* sway exists, so
# dbus-activated services (the portals) would inherit an environment with no
# WAYLAND_DISPLAY and fall back to X11 ("cannot open display"). Push the real
# session env onto the bus first. Unset variables are ignored.
exec --no-startup-id dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP

# No systemd on Void, so nothing socket-activates the audio stack.
exec --no-startup-id sh -c 'pgrep -x pipewire >/dev/null || pipewire &'
# mpd backs rmpc; nothing supervises it on Void, so start it here if it is down.
exec --no-startup-id sh -c 'pgrep -x mpd >/dev/null || mpd'
# mpd speaks no MPRIS on its own; mpDris2 bridges it so the XF86Audio
# transport keys (which go through playerctl) can drive rmpc.
exec --no-startup-id sh -c 'pgrep -x mpDris2 >/dev/null || mpDris2 &'
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1
exec --no-startup-id mako
# On-screen display for volume and brightness, as on mango.
exec --no-startup-id swayosd-server
exec --no-startup-id waybar
# Night colour temperature. Reads ~/.config/gammastep/config.ini, so mango and
# sway share one set of values. Guarded like the daemons above so a session
# restarted over a live one does not leave two instances fighting over the
# gamma ramp.
exec --no-startup-id sh -c 'pgrep -x gammastep >/dev/null || gammastep &'

exec_always --no-startup-id "$HOME/.config/sway/scripts/set-wallpaper.sh"

# No screen locking on this laptop - swaylock is removed, and swayidle is off
# the system too, so nothing blanks the panel on idle any more. The whole block
# is kept commented in case idling or locking is ever wanted back.
# exec --no-startup-id swayidle -w \
#     timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
#   timeout 300 'swaylock -f -c 000000' \
#   before-sleep 'swaylock -f -c 000000'

### Appearance
#
# Remove titlebars globally (pixel borders have no titlebar).
default_border pixel 2
default_floating_border pixel 2

# Lain border colors.
client.focused          #CE7688 #000000 #C1B48E #C1B48E #CE7688
client.focused_inactive #5D333C #000000 #965363 #5D333C #5D333C
client.unfocused        #381E24 #000000 #965363 #381E24 #381E24
client.urgent           #C1B48E #000000 #CE7688 #C1B48E #C1B48E
client.placeholder      #1D0F12 #000000 #965363 #1D0F12 #1D0F12

# Small gaps between tiled windows.
gaps inner 6
gaps outer 4

### Output configuration
#
# Names come from `swaymsg -t get_outputs`. This machine has eDP-1 built in,
# plus HDMI-A-1 / DP-1 / VGA-1 available for docking.
output eDP-1 scale 1

# Docking examples — uncomment and adjust as needed:
# output HDMI-A-1 resolution 1920x1080 position 1366,0
# output DP-1 resolution 1920x1080 position 1366,0
# output VGA-1 resolution 1680x1050 position 1366,0

### Input configuration
#
# Keyboard
# us,ua with Scroll Lock cycling them, matching mango/config.conf and
# hypr/configs/input.conf. sway keeps only the last xkb_options line, so
# caps:swapescape has to share this one comma-separated value.
input type:keyboard {
    xkb_layout us,ua
    xkb_options grp:sclk_toggle,caps:swapescape
}

# Mice
input type:pointer {
    accel_profile flat
    natural_scroll enabled
}

# Touchpad
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

# Close the lid, turn the panel off.
bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

### Key bindings
#
# Kept in step with mango/config.conf, which is the daily driver -- same key,
# same action, so muscle memory carries between hosts. Where mango does
# something sway cannot express the key is left unbound with a note, rather
# than quietly repurposed.
#
# One deliberate divergence from mango: the launcher is tofi where mango uses
# walker, since walker is not packaged for Void. Same key either way.
#
# Terminal:
#
    # Mod+Return is tmux and Mod+Shift+Return is a bare shell. mango and hypr
    # were flipped to match this, so all three now agree.
    bindsym $mod+Return exec $term -e tmux
    bindsym $mod+Shift+Return exec $term
    bindsym $mod+Ctrl+Return exec $term --float
    # $mod+c is free: clipse is retired on every host, so mango has no SUPER+c
    # either and there is nothing here to mirror.
#
# Core actions:
#
    bindsym $mod+r reload
    bindsym $mod+e exec $term -e yazi
    bindsym $mod+q kill
    bindsym $mod+space exec tofi-drun
    bindsym $mod+f fullscreen
    bindsym $mod+v floating toggle
    # mango toggleglobal shows a window on every tag; sticky is sway's version.
    bindsym $mod+g sticky toggle
    bindsym $mod+Shift+m exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

    # No sway analogue, left unbound rather than repurposed:
    #   $mod+Shift+f  mango togglefakefullscreen
    #   $mod+a        mango togglemaximizescreen
    #   $mod+o        mango toggleoverlay
    #   $mod+d, $mod+Shift+d  mango floating-window cycling (not wanted here)
    #   $mod+grave    mango drop-down console (not wanted here)
    # No screen locking on this laptop; swaylock and wlogout are not installed.
    #   $mod+F12 / $mod+Shift+F12
#
# Bar:
#
    bindsym $mod+b exec pkill -SIGUSR1 waybar
    bindsym $mod+Shift+b exec pkill -SIGUSR2 waybar
#
# Focus and movement:
#
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Tab focus next

    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right

    floating_modifier $mod normal
#
# Layout:
#
    # mango switch_layout cycles its tiling layouts; this is the nearest sway has.
    bindsym $mod+n layout toggle split tabbed stacking
    # mango binds Alt+Tab to its overview. sway has none, so this is just a
    # second cycle key.
    bindsym Alt+Tab focus next

    # mango scroller-layout binds have no sway equivalent at all:
    #   $mod+Alt+e, Alt+x, $mod+Alt+Ctrl+{Left,Right,Up,Down}
#
# Workspaces (mango tags 1-9; it has no tag 10):
#
    bindsym $mod+1 workspace 1
    bindsym $mod+2 workspace 2
    bindsym $mod+3 workspace 3
    bindsym $mod+4 workspace 4
    bindsym $mod+5 workspace 5
    bindsym $mod+6 workspace 6
    bindsym $mod+7 workspace 7
    bindsym $mod+8 workspace 8
    bindsym $mod+9 workspace 9

    bindsym $mod+Shift+1 move container to workspace 1
    bindsym $mod+Shift+2 move container to workspace 2
    bindsym $mod+Shift+3 move container to workspace 3
    bindsym $mod+Shift+4 move container to workspace 4
    bindsym $mod+Shift+5 move container to workspace 5
    bindsym $mod+Shift+6 move container to workspace 6
    bindsym $mod+Shift+7 move container to workspace 7
    bindsym $mod+Shift+8 move container to workspace 8
    bindsym $mod+Shift+9 move container to workspace 9

    # mango viewtoleft/viewtoright and their _have_client variants. sway has no
    # empty workspaces, so both pairs collapse onto prev/next_on_output.
    bindsym $mod+Left workspace prev_on_output
    bindsym $mod+Right workspace next_on_output
    bindsym $mod+comma workspace prev_on_output
    bindsym $mod+period workspace next_on_output

    # mango tagtoleft / tagtoright.
    bindsym $mod+Ctrl+Left move container to workspace prev_on_output
    bindsym $mod+Ctrl+Right move container to workspace next_on_output

    # mango axisbind: scroll over the desktop to change tag.
    bindsym --whole-window $mod+button4 workspace prev_on_output
    bindsym --whole-window $mod+button5 workspace next_on_output
#
# Scratchpad:
#
    bindsym $mod+minus move scratchpad
    bindsym $mod+equal scratchpad show
    # mango minimized / restore_minimized. sway has one mechanism where mango
    # has two, so these land on the same thing as the pair above; both are kept
    # so either reflex works.
    bindsym $mod+i move scratchpad
    bindsym $mod+Shift+i scratchpad show
#
# Resize (mango resizewin, +/-50px):
#
    bindsym $mod+Ctrl+Shift+$right resize grow width 50 px
    bindsym $mod+Ctrl+Shift+$left resize shrink width 50 px
    bindsym $mod+Ctrl+Shift+$up resize shrink height 50 px
    bindsym $mod+Ctrl+Shift+$down resize grow height 50 px
    bindsym $mod+Ctrl+Shift+Right resize grow width 50 px
    bindsym $mod+Ctrl+Shift+Left resize shrink width 50 px
    bindsym $mod+Ctrl+Shift+Up resize shrink height 50 px
    bindsym $mod+Ctrl+Shift+Down resize grow height 50 px
#
# Move floating window (mango movewin):
#
    bindsym Ctrl+Shift+Left move left 50 px
    bindsym Ctrl+Shift+Right move right 50 px
    bindsym Ctrl+Shift+Up move up 50 px
    bindsym Ctrl+Shift+Down move down 50 px
#
# Gaps:
#
    bindsym Alt+Shift+x gaps inner all plus 1
    bindsym Alt+Shift+z gaps inner all minus 1
    # mango togglegaps flips gaps off and back; this resets to the defaults set
    # in the Appearance block above.
    bindsym Alt+Shift+r gaps inner all set 6; gaps outer all set 4
#
# Monitors:
#
    bindsym Alt+Shift+Left focus output left
    bindsym Alt+Shift+Right focus output right
    bindsym $mod+Alt+Left move container to output left
    bindsym $mod+Alt+Right move container to output right
#
# Media and hardware:
#
# swayosd draws the volume/brightness bar, same as mango. It styles itself from
# ~/.config/swayosd/style.css, which both hosts share.
    bindsym --locked XF86AudioRaiseVolume exec swayosd-client --output-volume raise --max-volume 150
    bindsym --locked XF86AudioLowerVolume exec swayosd-client --output-volume lower
    bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle
    bindsym --locked XF86AudioMicMute exec ~/.config/waybar/scripts/toggle_mic.sh toggle
    bindsym $mod+m exec ~/.config/waybar/scripts/toggle_mic.sh toggle

    # mpd has no MPRIS of its own; mpDris2 bridges it for playerctl, which is
    # what swayosd --playerctl drives.
    bindsym --locked XF86AudioPlay exec swayosd-client --playerctl play-pause
    bindsym --locked XF86AudioPrev exec swayosd-client --playerctl prev
    bindsym --locked XF86AudioNext exec swayosd-client --playerctl next

    bindsym --locked XF86MonBrightnessUp exec swayosd-client --brightness raise
    bindsym --locked XF86MonBrightnessDown exec swayosd-client --brightness lower
#
# Screenshots:
#
# One script for all three compositors -- it only calls grim/slurp/swappy, so
# nothing in it is compositor-specific. Lives in the shared scripts/ dir because
# .chezmoiignore drops .config/mango on this host.
#
    bindsym Print exec ~/.config/scripts/screenshot.sh full
    bindsym $mod+Print exec ~/.config/scripts/screenshot.sh output
    bindsym $mod+Shift+Print exec ~/.config/scripts/screenshot.sh region
    # Xbox Series Share button (xpad emits KEY_RECORD).
    bindsym XF86AudioRecord exec ~/.config/scripts/screenshot.sh game

### Window rules
#
# scripts/term tags float windows with BOTH an app_id and a title, because the
# flag differs per emulator (foot --app-id, kitty/alacritty --class + --title).
# Match both so the rule holds whichever terminal is installed.
for_window [app_id="termfloat"] floating enable
for_window [title="termfloat"] floating enable

include /etc/sway/config.d/*
