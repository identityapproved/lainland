# Taskwarrior config.
# Lives in the repo and is symlinked to ~/.config/task (XDG location task 3.x reads).
news.version=3.4.2

pager=bat --paging=always
editor=nvim -f

include ~/.config/task/themes/lain-256.theme

# Per-host, deliberately outside the chezmoi tree so it is never committed and
# never applied to another machine. Holds sync.encryption_secret, which must be
# byte-identical on every replica, and recurrence, which must be on for exactly
# one replica and off for all the others. See task-sync(5).
include ~/.local/share/task/local.taskrc
