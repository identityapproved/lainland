### Video output (Hyprland-safe)
vo=gpu
gpu-context=wayland
icc-profile-auto=no
target-colorspace-hint=no

### Scaling
scale=ewa_lanczossharp
cscale=ewa_lanczossharp
dscale=mitchell

### Color & dithering
video-output-levels=auto
dither-depth=auto
dither=fruit

### Timing
video-sync=audio
interpolation=no

### Subtitles
sub-ass-use-video-data=all
sub-ass-override=no
sub-scale=1
# Enable subtitles by default
sub-auto=all
sid=auto
# Subtitle language priority:
# Ukrainian → Russian → English
slang=uk,ukr,ua,ru,rus,en,eng
# Use full (non-forced) subtitles
sub-forced-events-only=no
# Automatically load subtitle files
sub-file-paths=.
# Second subtitle track, rendered at the top of the screen.
# "auto" picks the next best track by the slang priority above.
secondary-sid=auto
secondary-sub-pos=0
secondary-sub-visibility=yes
# Strip ASS styling so the secondary cannot be positioned over the primary
secondary-sub-ass-override=strip

### Audio
ao=pipewire
audio-channels=auto
# audio-resample-filter-size=16
# audio-resample-phase-shift=10
# Prefer Japanese audio
alang=ja,jpn,japanese

### Usability
save-position-on-quit=yes
keep-open=yes
autofit-larger=95%x95%

### Cache
cache=yes
demuxer-max-bytes=512MiB
demuxer-max-back-bytes=128MiB

### Debug
msg-level=vo=v

### Aspect ratio / geometry
video-aspect-override=-1
keepaspect=yes
vf=setsar=1
autofit-larger=95%x95%

### Try to fix refresh mismatch
# vo=gpu-next
hwdec=auto
# video-sync=display-resample
# interpolation=no
# scale=bilinear
