{{- $term := "" -}}
{{- range list "kitty" "foot" "alacritty" -}}
  {{- if and (eq $term "") (lookPath .) }}{{ $term = . }}{{ end -}}
{{- end -}}
#!/bin/sh
# Terminal resolver. GENERATED BY CHEZMOI -- edit dot_config/scripts/term.tmpl.
#
# Resolved on this host: {{ if $term }}{{ $term }}{{ else }}(none installed){{ end }}
#
# Why this exists: the terminal used to be hardcoded seven times over -- kitty in
# hypr/configs/defaults.conf, mango/config.conf and tofi/config, foot in
# sway/config -- so a host without that one binary had a rice with no terminal.
# The compositor configs now all call this instead, and chezmoi picks the first
# installed of kitty/foot/alacritty at apply time.
#
# Usage:
#   term                 interactive shell
#   term -e CMD [ARG...] run a command
#   term --float [-e ..] scratch window, tagged termfloat
#   term --id NAME [-e ..] window tagged NAME (sway's drop-down console)
#
# The --float case is why this is a script and not just $TERMINAL. Each
# compositor matches its float rule on a different property, because each
# terminal spells the flag differently:
#
#   hypr / mango   windowrule on  title:termfloat     (kitty --title)
#   sway           for_window on  app_id="termfloat"  (foot --app-id)
#
# So both identities are set on every terminal, and one rule per compositor then
# holds regardless of which one is installed.

set -eu

TERM_BIN="{{ $term }}"

if [ -z "$TERM_BIN" ]; then
    echo "term: no terminal found (looked for kitty, foot, alacritty)" >&2
    exit 127
fi

id=
case "${1-}" in
    --float) id=termfloat; shift ;;
    --id) id=${2:?term: --id needs a name}; shift 2 ;;
esac

case "$TERM_BIN" in
    kitty)
        [ -n "$id" ] && set -- --title "$id" --class "$id" "$@"
        ;;
    foot)
        # foot spells it --app-id and takes -e without a separator, same as kitty.
        [ -n "$id" ] && set -- --app-id="$id" --title="$id" "$@"
        ;;
    alacritty)
        # alacritty wants -e as its LAST option; --class takes general,instance.
        [ -n "$id" ] && set -- --class "$id,$id" --title "$id" "$@"
        ;;
esac

exec "$TERM_BIN" "$@"
