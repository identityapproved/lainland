# mako — Lain. Palette: lain-colors.md (private repo).
# Alpha on the surfaces matches waybar's 0.9 bar so notifications read as part
# of the same chrome layer.
anchor=top-right
font=Iosevka Nerd Font Propo 11
background-color=#000000f0
text-color=#CE7688
border-color=#965363
text-alignment=right
width=230
height=123
outer-margin=12,12,12,12
margin=8
padding=10
border-size=1
border-radius=0
default-timeout=2300
ignore-timeout=1
group-by=summary

actions=1

[grouped]
format=<b>%s</b>\n%b

[urgency=low]
background-color=#1A1A1Af0
text-color=#804654
border-color=#3A3A3A
default-timeout=2300

[urgency=normal]
background-color=#000000f0
text-color=#CE7688
border-color=#965363
default-timeout=10000

[urgency=high]
background-color=#000000f0
text-color=#FFB1C3
border-color=#C1B48E
default-timeout=8000
