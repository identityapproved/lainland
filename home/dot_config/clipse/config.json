{
  "allowDuplicates": false,
  "historyFile": "clipboard_history.json",
  "maxHistory": 100,
  "deleteAfter": 0,
  "logFile": "clipse.log",
  "pollInterval": 50,
  "maxEntryLength": 120,
  "themeFile": "custom_theme.json",
  "tempDir": "tmp_files",
  "keyBindings": {
    "choose": "enter",
    "clearSelected": "S",
    "down": "j,down",
    "end": "G",
    "filter": "/",
    "forceQuit": "esc",
    "home": "g",
    "more": "?",
    "nextPage": "ctrl+n,l,right",
    "prevPage": "ctrl+p,h,left",
    "preview": "o",
    "quit": "q",
    "remove": "d",
    "selectDown": "shift+down",
    "selectSingle": "s",
    "selectUp": "shift+up",
    "togglePin": "p",
    "togglePinned": "tab",
    "up": "k,up",
    "yankFilter": "ctrl+s"
  },
  "imageDisplay": {
    "type": "basic",
    "scaleX": 9,
    "scaleY": 9,
    "heightCut": 2
  },
  "excludedApps": [
    "1Password",
    "Bitwarden",
    "KeePassXC",
    "LastPass",
    "Dashlane",
    "Password Safe",
    "Keychain Access"
  ],
  "autoPaste": {
    "enabled": false,
    "keybind": "ctrl+v",
    "buffer": 10
  },
  "enableMouse": true,
  "enableDescription": true
}
