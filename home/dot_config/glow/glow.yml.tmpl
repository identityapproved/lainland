# glow config -- Lain.
#
# The style is a glamour JSON file, not a named theme, so it has to be given as
# a path. glow does not expand `~`, so chezmoi writes the absolute path here at
# apply time; edit the template, not the generated file.
#
# Colors live in themes/lain.json and come from lain-colors.md.
# glow's own TUI chrome (the file browser, `glow -t`) is hardcoded in the
# binary and is not themeable -- only rendered markdown follows this style.

# style name or JSON path (default "auto")
style: "{{ .chezmoi.homeDir }}/.config/glow/themes/lain.json"
# mouse support (TUI-mode only)
mouse: false
# use pager to display markdown
pager: false
# word-wrap at width
width: 80
# show all files, including hidden and ignored.
all: false
