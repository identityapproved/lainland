# .zshenv — sourced for EVERY zsh (login, interactive, scripts), before all else.
# Keep it minimal and side-effect-free: only environment that non-interactive
# shells and scripts also need. Interactive-only setup lives in rc.d/.
#
# PATH is intentionally NOT here: Gentoo's /etc/zsh/zprofile runs `env-update`,
# which resets PATH *after* .zshenv is read. PATH lives in .zprofile.

export EDITOR="nvim"
export MANPAGER="nvim +Man!"
export GOPATH="$HOME/go"
export XDG_DATA_HOME="$HOME/.local/share"
export AGENTSDOTS_ROOT="$HOME/github/agentsdots"
export ZK_NOTEBOOK_DIR="$HOME/zettelnotes"
export ZETTEL_DIR="$HOME/zettelnotes"
export BAT_THEME="Lain"   # used by bat, the cat= alias, and fzf previews

# VISUAL, not EDITOR, is what git, lazygit and aerc reach for first.
export VISUAL="nvim"
export PAGER="less"
export BROWSER="firefox"
export CARGO_HOME="$HOME/.cargo"
export RUSTUP_HOME="$HOME/.rustup"

# The terminal is resolved at chezmoi apply time; see .config/scripts/term.
export TERMINAL="$HOME/.config/scripts/term"

# Void mounts /tmp noexec and cargo's build scripts exec out of $TMPDIR, so it
# has to point somewhere exec-allowed. Harmless on a host where /tmp is exec.
# Created here rather than left to chezmoi: nothing else makes it, and a TMPDIR
# that does not exist breaks mktemp and every build that uses it.
export TMPDIR="$HOME/.cache/tmp"
[ -d "$TMPDIR" ] || mkdir -p "$TMPDIR"

# pixrupt's target tree alone is ~12G, which does not belong on a 107G root.
# This laptop has a spare ext4 disk at /mnt/hgst; no other host has one. The
# guard tests the directory, not the mountpoint: /mnt/hgst exists unmounted too,
# and writing there would quietly fill / instead of sparing it. So this is inert
# on gentoo and after an unmounted boot, where cargo falls back to each crate's
# own target/.
[ -d /mnt/hgst/cargo-target ] && export CARGO_TARGET_DIR=/mnt/hgst/cargo-target

# zoxide's doctor false-positives in snapshot-restored shells (Claude Code and
# friends re-source a dump of our *functions* into a fresh `zsh -c`, which brings
# back zoxide's cd wrapper but not the chpwd_functions array it hooks into), so
# every `cd` there prints the "initialize zoxide last" nag. Init order is already
# correct — see rc.d/50-tools.zsh. Silence it for non-interactive shells only, so
# a genuine ordering regression still shows up in a real terminal.
[[ -o interactive ]] || export _ZO_DOCTOR=0

# Local LLM (ollama): offline FIM + chat for Neovim.
# Runbook: ~/zettelnotes/adeg_local-llm-fim-and-chat-in-neovim.md
#
# Neovim reads the three LOCAL_* vars via lua/config/localllm.lua, which is the
# only reason that config needs no host branches. Endpoint is loopback on every
# host: the ollama API is unauthenticated, so the bind address is the whole
# access control story.
export LOCAL_LLM_URL="http://127.0.0.1:11434"

# Model tier follows the host's capability, not its name -- same reasoning as
# the CARGO_TARGET_DIR guard above. g33nto has headroom for 7B; voidbox is Bay
# Trail with no AVX and 7.6G, so it gets 3B. FIM needs the -base tags: the
# instruct variants answer in prose instead of completing.
if [ -r /etc/gentoo-release ]; then
  export LOCAL_FIM_MODEL="qwen2.5-coder:7b-base"
  export LOCAL_CHAT_MODEL="qwen2.5-coder:7b-instruct"
else
  # 0.5B, not 3B: measured on voidbox, uncached prompt eval is 14.3 tok/s at
  # 0.5B vs 1.6 at 3B, i.e. ~12s vs ~96s for a completion in a fresh spot, and
  # 3B was no better on a FIM test. See the note's benchmark table.
  export LOCAL_FIM_MODEL="qwen2.5-coder:0.5b-base"
  export LOCAL_CHAT_MODEL="qwen2.5-coder:3b-instruct"
fi

# Already the upstream default, pinned so a future default change cannot
# silently widen it. Also points the client at the container's published port
# on hosts where ollama runs under podman.
export OLLAMA_HOST="127.0.0.1:11434"
# 0.34.x ships remote inference and web search. This is the offline fallback,
# so both stay off and no prompt leaves the machine.
export OLLAMA_NO_CLOUD=1

# Server-side tuning; inert where ollama runs in a container, which takes these
# from its compose environment instead. KEEP_ALIVE matters most on voidbox:
# the 5m default means a cold multi-second model reload on most triggers.
export OLLAMA_KEEP_ALIVE=30m
export OLLAMA_MAX_LOADED_MODELS=1   # raise to 2 to keep FIM+chat both resident
export OLLAMA_NUM_PARALLEL=1
export OLLAMA_CONTEXT_LENGTH=4096
