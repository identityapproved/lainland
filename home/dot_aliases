# Full Gentoo system update (eix-sync = emerge --sync + eix-update)
sysup() {
  doas eix-sync &&
  eselect news read &&
  doas emerge -auDN @world &&
  doas emerge --depclean --ask &&
  doas dispatch-conf
}

