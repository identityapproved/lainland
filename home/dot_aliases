# ProtonVPN over raw WireGuard. Configs live in /etc/wireguard (dir 755, keys 600).
# wg-quick needs root -> interactive `doas` only; no passwordless rules.
#   vpn up [name]   pick (fzf) or name a server and connect
#   vpn upr [filt]  connect to a random server, optionally filtered (e.g. `vpn upr FI`)
#   vpn down        tear down the active tunnel
#   vpn list        list available servers
#   vpn status      show the active interface/endpoint
vpn() {
  local dir=/etc/wireguard
# local tsnet=100.64.0.0/10 tstable=52 tsprio=5000   # pin tailnet out tailscale0, above Proton's rules
  local tsnet=100.64.0.0/10 tstable=52 tsprio=4990
  local cur; cur=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' 'NR==1{print $2}')
  case "${1:-status}" in
    list)
      for f in "$dir"/*.conf(N); do print -r -- "${f:t:r}"; done
      ;;
    up|upr)
      local name="${2:-}"
      if [ "$1" = upr ]; then
        local -a pool
        pool=("$dir"/*${2:-}*.conf(N:t:r))
        (( $#pool )) || { echo "no server matches: ${2:-*}" >&2; return 1; }
        name=$pool[$((RANDOM % $#pool + 1))]
        echo "random: $name"
      elif [ -z "$name" ]; then
        name=$(for f in "$dir"/*.conf(N); do print -r -- "${f:t:r}"; done \
          | fzf --prompt='proton > ' --header='enter: connect / esc: cancel')
      fi
      [ -n "$name" ] || return 0
      [ -f "$dir/$name.conf" ] || { echo "unknown server: $name" >&2; return 1; }
      [ -n "$cur" ] && doas wg-quick down "$cur"
      doas wg-quick up "$name" || return
      # keep the tailnet reachable while Proton owns the default route (re-add idempotently)
      doas sh -c "ip rule del to $tsnet priority $tsprio 2>/dev/null; ip rule add to $tsnet lookup $tstable priority $tsprio"
      ;;
    down)
      if [ -n "$cur" ]; then
        doas sh -c "wg-quick down '$cur'; ip rule del to $tsnet priority $tsprio 2>/dev/null"
      else
        echo "no active tunnel"
      fi
      ;;
    status)
      if [ -n "$cur" ]; then
        local ep; ep=$(ip route show | awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && /via/ {print $1; exit}')
        echo "up: ${cur#wg-} (endpoint ${ep:-?})"
      else
        echo "down"
      fi
      ;;
    *) echo "usage: vpn {up [name]|upr [filter]|down|list|status}" >&2; return 2 ;;
  esac
}

