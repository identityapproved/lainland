# --- fzf helpers (ported from fish) ---------------------------------------
# pick a command from the completion table, then act on it
fman() {
  local cmd
  cmd=$(print -rl -- ${(k)commands} | sort -u | fzf --height 40% --layout reverse --border --no-preview) \
    && man "$cmd"
}

ftldr() {
  if (( $# > 0 )); then
    tldr "$@"
    return
  fi
  local cmd
  cmd=$(print -rl -- ${(k)commands} | sort -u | fzf --height 40% --layout reverse --border --no-preview) \
    && tldr "$cmd"
}

# fuzzy-pick a path under $HOME and cd into its directory
fcd() {
  cd ~ || return
  local target
  target=$(fzf | sed 's:/[^/]*$::') && [[ -n "$target" ]] && cd "$target"
}

# fuzzy-pick a file and open/cat/bat it
fv()   { local f; f=$(fzf) && [[ -n "$f" ]] && nvim "$f"; }
fcat() { local f; f=$(find . -type f | fzf) && [[ -n "$f" ]] && cat "$f"; }
fbat() { local f; f=$(find . -type f | fzf) && [[ -n "$f" ]] && bat "$f"; }

# scratch markdown buffer in $TMPDIR
