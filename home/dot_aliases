# --- taskwarrior fuzzy search ---------------------------------------------
tws() {
  command -v fzf >/dev/null || { echo "tws requires fzf"; return 1; }
  local query="$*" selected id
  selected=$(task rc.color=off rc._forcecolor=no rc.defaultwidth=1000 list | awk '
      NR <= 3 { next }
      /^[[:space:]]*$/ { next }
      /^[[:space:]]*[0-9]+ tasks?[[:space:]]*$/ { next }
      { print }
    ' | fzf --query="$query" --height 80% --layout=reverse --border \
        --header="Taskwarrior search") || return
  id=$(printf '%s\n' "$selected" | awk '{print $1}')
  [[ -n "$id" ]] && task "$id" info
}

# --- pipewire: pick default sink ------------------------------------------
wptui-default-sink() {
  local candidates=() line id selected
  while IFS= read -r line; do
    id=${line%% *}
    if wpctl inspect "$id" 2>/dev/null | grep -q 'media.class = "Audio/Sink"'; then
      candidates+=("$line")
    fi
  done < <(wpctl status --name | awk '
      /Sinks:/   { in_audio_sinks=1; next }
      /Sources:/ { in_audio_sinks=0 }
      /Filters:/ { in_filters=1; next }
      /Streams:/ { in_filters=0 }
      (in_audio_sinks || in_filters) && /[0-9]+\./
    ' | sed -E 's/.* ([0-9]+)\.[[:space:]]+(.*)/\1 \2/')
  selected=$(printf '%s\n' "${candidates[@]}" | fzf --prompt='Select sink > ') || return
  id=${selected%% *}
  [[ -n "$id" ]] && wpctl set-default "$id"
}

# --- podman + fzf ---------------------------------------------------------
pstart() {
  local selected
  selected=$(podman ps -a --format "{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}" \
    | fzf --height 40% --reverse --border --header "select container to start")
  [[ -z "$selected" ]] && return
  podman start "$(echo "$selected" | awk '{print $1}')"
}

pstop() {
  local selected
  selected=$(podman ps --format "{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}" \
    | fzf --height 40% --reverse --border --header "select container to stop")
  [[ -z "$selected" ]] && return
  podman stop "$(echo "$selected" | awk '{print $1}')"
}

prm() {
  local selected
  selected=$(podman ps -a --format "{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}" \
    | fzf --height 40% --reverse --border --header "select container to remove")
  [[ -z "$selected" ]] && return
  podman rm "$(echo "$selected" | awk '{print $1}')"
}

# --- process picker (view PID -> clipboard, or kill) ----------------------
pz() {
  local sort_option="" header="Search processes" action="view"
  while (( $# > 0 )); do
    case "$1" in
      -m|--mem)  sort_option="--sort=-%mem"; header="Search by memory usage" ;;
      -k|--kill) action="kill"; header="Kill process" ;;
      -h|--help)
        echo "Usage: pz [-m|--mem] [-k|--kill]"
        echo "  -m  Sort by memory usage"
        echo "  -k  Kill selected process"
        return 0 ;;
    esac
    shift
  done

  local selection pid confirm
  selection=$(ps aux $sort_option | fzf --ansi --header="$header" \
    --layout=reverse --height=80% \
    --preview='pid=$(echo {} | awk "{print \$2}"); \
      ps -p $pid -o pid= -o ppid= -o user= -o %cpu= -o %mem= -o etime= -o cmd=') || return
  pid=$(echo "$selection" | awk '{print $2}')
  [[ -z "$pid" ]] && return 1

  if [[ "$action" == kill ]]; then
    read "confirm?Kill process PID $pid? [y/N]: "
    if [[ "$confirm" == [Yy] ]]; then
      doas kill -9 "$pid" && echo "Process $pid killed."
    else
      echo "Canceled."
    fi
  else
    echo -n "$pid" | wl-copy
    echo "PID $pid copied to clipboard."
  fi
}
