# Gentoo's /etc/zsh/zprofile resets PATH — put custom paths here, not in .zshrc

export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"  # `go install` binaries (catnip, …)

# Machine-local login setup, not managed by this repo: NN-name.zsh files in
# ~/.config/zsh/profile.d/. PATH additions go here rather than env.d/, which
# runs from .zshenv before Gentoo's zprofile resets PATH.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}"/zsh/profile.d/*.zsh(N); do
  [[ -r "$_f" ]] && source "$_f"
done
unset _f

# Flatpak exports reach XDG_DATA_DIRS via /etc/profile.d/flatpak.sh (sourced by greetd
# and /etc/zsh/zprofile) before the compositor starts; setting them here duplicated them.
# Do not set XDG_DATA_DIRS in mango/config.conf either (it would clobber this).

# nb notebooks. Set before the mango exec below so everything the compositor
# spawns (waybar's nb module, terminals) sees the same notebook dir.
export NB_DIR="$HOME/nb"

# One ssh-agent per session on a fixed socket, before the compositor exec, so
# launchers and KeePassXC inherit it (greetd's mango session never reads .zshrc).
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-$HOME/.ssh}/ssh-agent.socket"
ssh-add -l >/dev/null 2>&1
[ $? -eq 2 ] && rm -f "$SSH_AUTH_SOCK" && ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null

# Auto-start the compositor on tty1. The only templated part of this file --
# the exec is mutually exclusive by definition, so it cannot be a runtime check.
#
# sway goes through .config/sway/start-sway rather than `dbus-run-session sway`:
# mango sets its session env with `env=` lines in mango/config.conf and hyprland
# in configs/envars.conf, but sway has no equivalent. Its `exec` runs after the
# compositor is already up, which is too late for XDG_CURRENT_DESKTOP (the portal
# matches it against UseIn= in wlr.portal) and too late for the Electron/Qt/
# Firefox Wayland hints. start-sway is the sway analogue of those env blocks.
#
# No logging by default. To debug a session that will not start, swap the exec
# below for the commented line, `chezmoi apply`, and retry.
if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
{{- if eq .wm "sway" }}
    # exec "$HOME/.config/sway/start-sway" >>"$HOME/.local/state/sway.log" 2>&1
    exec "$HOME/.config/sway/start-sway"
{{- else if eq .wm "hyprland" }}
    exec dbus-run-session Hyprland
{{- else }}
    exec dbus-run-session mango
{{- end }}
fi
